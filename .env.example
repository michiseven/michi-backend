APP_ENV=development
HOST=127.0.0.1
PORT=4100
API_PREFIX=/api/admin

POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=michi
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_SSL=false

# Admin 인증 데이터 전용 연결입니다. 비워 두면 위 POSTGRES_* 값을 사용합니다.
# 운영에서는 public 스키마는 SELECT, admin 스키마만 쓰기 가능한 별도 계정을 사용하세요.
ADMIN_POSTGRES_HOST=
ADMIN_POSTGRES_PORT=
ADMIN_POSTGRES_DB=michi
ADMIN_POSTGRES_USER=
ADMIN_POSTGRES_PASSWORD=
ADMIN_DATABASE_SSL=false

# true이면 서버 시작 전에 admin 스키마 Flyway migration을 실행합니다.
ADMIN_MIGRATIONS_ENABLED=false

MICHI_PUBLIC_API_URL=http://localhost:4000/api
ADMIN_CORS_ORIGIN=http://localhost:3100

ADMIN_AUTH_MODE=disabled
ADMIN_SESSION_TTL_HOURS=12

# 최초 Owner 생성 시에만 입력하고 bootstrap 후 제거하세요.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_DISPLAY_NAME=
ADMIN_BOOTSTRAP_PASSWORD=
