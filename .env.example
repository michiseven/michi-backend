POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=michi
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=
DATABASE_SSL=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
LLM_PROVIDER_MODE=mock
OPENAI_WEB_SEARCH_MODEL=gpt-5.6-luna
PLACE_DETAIL_WEB_SEARCH_ENABLED=false
PLACE_DETAIL_WEB_CACHE_TTL_SECONDS=86400

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_LOCAL_SEARCH_URL=https://naverapihub.apigw.ntruss.com/search/v1/local
KAKAO_REST_API_KEY=
KAKAO_LOCAL_SEARCH_URL=https://dapi.kakao.com/v2/local/search/keyword.json

# NAVER Cloud Maps Directions 5 (자동차/택시 전용; Local Search 키와 별도 Application일 수 있음)
ROUTING_PROVIDER_MODE=mock
ROUTING_SHORT_WALK_MAX_METERS=1000
ROUTING_SHORT_WALK_MIN_SAVINGS_MINUTES=3
NAVER_MAPS_API_KEY_ID=
NAVER_MAPS_API_KEY=
NAVER_DIRECTIONS_URL=https://naveropenapi.apigw.ntruss.com/map-direction/v1
ACCESSIBILITY_CORRIDOR_METERS=20
ACCESSIBILITY_ELEVATION_SEARCH_METERS=200
ACCESSIBILITY_STEEP_SLOPE_PERCENT=8
PLACE_PROVIDER_LIVE_SOURCE=kakao
PLACE_PROVIDER_MODE=mock

# 한국관광공사 일문 TourAPI: 서울 POI 수동 동기화에만 사용
KTO_TOUR_API_KEY=
KTO_PROVIDER_MODE=mock
KTO_DATALAB_API_KEY=
KTO_DATALAB_PROVIDER_MODE=mock
KTO_DATALAB_CONCENTRATION_URL=https://apis.data.go.kr/B551011/TatsCnctrRateService/tatsCnctrRatedList
KTO_TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/JpnService2
KTO_MOBILE_APP=Michi

SEOUL_OPEN_DATA_API_KEY=
SEOUL_OPEN_DATA_BASE_URL=http://openapi.seoul.go.kr:8088
CROWD_PROVIDER_MODE=mock
PROVIDER_CACHE_TTL_SECONDS=300

# 서울교통공사 지하철 최단경로 API (OA-22724, getShtrmPath)
SEOUL_SUBWAY_PROVIDER_MODE=mock
SEOUL_SUBWAY_API_BASE_URL=http://openapi.seoul.go.kr:8088
SEOUL_SUBWAY_SEARCH_TYPE=duration
SEOUL_SUBWAY_MAX_ACCESS_METERS=1500
SEOUL_SUBWAY_STATION_SERVICE=subwayStationMaster

# 서울시 정류장마스터. 버스 P2P 경로 또는 실시간 도착 API가 아님
SEOUL_BUS_PROVIDER_MODE=mock
SEOUL_BUS_STATION_SERVICE=tbisMasterStation

PORT=4000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000
LOG_FRIENDS_INGEST_URL=
LOG_FRIENDS_WORKER_ID=michi-backend
LOG_FRIENDS_APP_NAME=michi
JWT_ACCESS_SECRET=
# production에서는 반드시 true이며 false로 설정하면 서버가 시작되지 않습니다.
AUTH_COOKIE_SECURE=false
# none은 AUTH_COOKIE_SECURE=true일 때만 허용됩니다.
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_PATH=/api/auth

# LangGraph Stateful Chat Workflow
CHAT_GRAPH_ENABLED=true
CHAT_CHECKPOINTER_MODE=memory
CHAT_CHECKPOINT_RETENTION_DAYS=30
